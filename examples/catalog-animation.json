{
  "schemaVersion": 1,
  "name": "Catalog animation",
  "scene": {
    "durationMs": 5000,
    "elements": {
      "title": { "kind": "text", "text": "Geometria", "position": [0, 2.5, 0], "appearsAtMs": 0, "color": "#FFFFFF" },
      "circle": { "kind": "circle", "radius": 1.2, "position": [-2, 0, 0], "appearsAtMs": 1000, "color": "#58C4DD" },
      "arrow": { "kind": "arrow", "position": [-1, -2, 0], "end": [1, -2, 0], "appearsAtMs": 3000, "color": "#FFFF00" }
    },
    "animations": [
      { "kind": "write", "targetId": "title", "startMs": 0, "durationMs": 800 },
      { "kind": "create", "targetId": "circle", "startMs": 1000, "durationMs": 1000 },
      { "kind": "moveTo", "targetId": "circle", "startMs": 2000, "durationMs": 800, "destination": [2, 0, 0] },
      { "kind": "fadeIn", "targetId": "arrow", "startMs": 3000, "durationMs": 700 },
      { "kind": "fadeOut", "targetId": "title", "startMs": 3700, "durationMs": 800 }
    ]
  }
}
