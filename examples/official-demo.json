{
  "schemaVersion": 1,
  "name": "Parabola transformation",
  "scene": {
    "durationMs": 12000,
    "elements": {
      "axes": { "kind": "axes", "position": [0, 0, 0], "appearsAtMs": 0, "xRange": [-4, 4], "yRange": [-2, 8], "color": "#FFFFFF" },
      "graph": { "kind": "functionGraph", "expression": "x^2", "position": [0, 0, 0], "appearsAtMs": 1000, "xRange": [-2.5, 2.5], "color": "#58C4DD" },
      "equation": { "kind": "mathTex", "latex": "f(x)=x^2", "position": [-4.5, 3, 0], "appearsAtMs": 3000, "color": "#FFFFFF" },
      "annotation": { "kind": "text", "text": "Vertex at the origin", "position": [3, 2.5, 0], "appearsAtMs": 5000, "color": "#FFFF00" },
      "target": { "kind": "functionGraph", "expression": "x^2", "position": [2, 1, 0], "appearsAtMs": 1000, "xRange": [-2.5, 2.5], "color": "#FC6255" }
    },
    "animations": [
      { "kind": "create", "targetId": "axes", "startMs": 0, "durationMs": 1000 },
      { "kind": "create", "targetId": "graph", "startMs": 1000, "durationMs": 1500 },
      { "kind": "write", "targetId": "equation", "startMs": 3000, "durationMs": 1000 },
      { "kind": "fadeIn", "targetId": "annotation", "startMs": 5000, "durationMs": 800 },
      { "kind": "transform", "targetId": "graph", "destinationId": "target", "startMs": 6000, "durationMs": 1800 },
      { "kind": "moveTo", "targetId": "annotation", "startMs": 8000, "durationMs": 1000, "destination": [2, 3, 0] },
      { "kind": "fadeOut", "targetId": "annotation", "startMs": 9000, "durationMs": 800 }
    ]
  }
