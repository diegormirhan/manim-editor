{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Manim editor project",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "scene"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "durationMs",
        "elements"
      ],
      "properties": {
        "durationMs": {
          "type": "integer",
          "minimum": 1
        },
        "elements": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "$ref": "#/$defs/mathTex"
              },
              {
                "$ref": "#/$defs/text"
              },
              {
                "$ref": "#/$defs/circle"
              },
              {
                "$ref": "#/$defs/dot"
              },
              {
                "$ref": "#/$defs/ellipse"
              },
              {
                "$ref": "#/$defs/rectangle"
              },
              {
                "$ref": "#/$defs/square"
              },
              {
                "$ref": "#/$defs/triangle"
              },
              {
                "$ref": "#/$defs/regularPolygon"
              },
              {
                "$ref": "#/$defs/arc"
              },
              {
                "$ref": "#/$defs/line"
              },
              {
                "$ref": "#/$defs/arrow"
              },
              {
                "$ref": "#/$defs/axes"
              },
              {
                "$ref": "#/$defs/numberPlane"
              },
              {
                "$ref": "#/$defs/numberLine"
              },
              {
                "$ref": "#/$defs/functionGraph"
              },
              {
                "$ref": "#/$defs/areaUnderGraph"
              }
            ]
          }
        },
        "animations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/animation"
          }
        }
      }
    }
  },
  "$defs": {
    "mathTex": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "position",
        "appearsAtMs",
        "latex"
      ],
      "properties": {
        "kind": {
          "const": "mathTex"
        },
        "position": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "appearsAtMs": {
          "type": "integer",
          "minimum": 0
        },
        "disappearsAtMs": {
          "type": "integer",
          "minimum": 1
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "scale": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 10
        },
        "rotationDegrees": {
          "type": "number",
          "minimum": -360,
          "maximum": 360
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "latex": {
          "type": "string",
          "minLength": 1
        },
        "fontSize": {
          "type": "number",
          "minimum": 8,
          "maximum": 144
        }
      }
    },
