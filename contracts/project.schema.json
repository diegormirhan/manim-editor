          "minimum": 1
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "scale": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 10
        },
        "rotationDegrees": {
          "type": "number",
          "minimum": -360,
          "maximum": 360
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "graphId": {
          "type": "string",
          "minLength": 1
        },
        "xRange": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "animation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "startMs",
        "durationMs"
      ],
      "properties": {
        "kind": {
          "enum": [
            "create",
            "write",
            "fadeIn",
            "grow",
            "drawBorder",
            "fadeOut",
            "moveTo",
            "transform",
            "rotate",
            "scaleTo",
            "recolor",
            "indicate",
            "wiggle",
            "parallel"
          ]
        },
        "targetId": {
          "type": "string",
          "minLength": 1
        },
        "startMs": {
          "type": "integer",
          "minimum": 0
        },
        "durationMs": {
          "type": "integer",
          "minimum": 67
        },
        "destination": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "destinationId": {
          "type": "string",
          "minLength": 1
        },
        "degrees": {
          "type": "number",
          "minimum": -1080,
          "maximum": 1080
        },
        "factor": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 10
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "clips": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/animation"
          }
        }
      }
    }
  }
}
