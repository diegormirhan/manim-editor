{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "manim-editor",
  "version": "../package.json",
  "identifier": "com.manimeditor.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "manim-editor",
        "width": 1280,
        "height": 860,
        "minWidth": 800,
        "minHeight": 650,
        "label": "main",
        "decorations": false,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../.venv": ".venv",
      "../renderer": "renderer",
      "../contracts": "contracts",
      "../work/runtime/tex": "work/runtime/tex"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY1Q0E4MTdFQkE1OTU4NkQKUldSdFdGbTZmb0hLWlV6RDlIcmZHKzV3Rm45cThwT045bkc2TzY1UWVDR0dweVBEbndyZlZ0ZEwK",
      "endpoints": [
        "https://github.com/diegormirhan/manim-editor/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
