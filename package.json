{
  "name": "manim-editor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/generate-schema.mjs && node scripts/generate-contract.mjs && tsc --noEmit && vite build",
    "test": "node scripts/generate-schema.mjs && node scripts/generate-contract.mjs && vitest run src",
    "tauri": "tauri",
    "desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/desktop.ps1 dev",
    "test:e2e": "playwright test",
    "build:installers": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/desktop.ps1 build",
    "build:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-portable.ps1",
    "build:offline-runtime": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-offline.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "ajv": "^8",
    "lucide-react": "^0.577.0",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "latest",
    "json-schema-to-typescript": "^16.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9",
    "vite": "latest",
    "vitest": "latest"
  }
}
